{
  "name": "socbuilder",
  "displayName": "SoCBuilder",
  "description": "SystemVerilog productivity tools for SoC design (align, instantiate, etc.)",
  "version": "0.4.0",
  "publisher": "WendellZhao",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onCommand:socBuilder.alignDeclarations",
    "onCommand:socBuilder.instantiateModuleByName",
    "onCommand:socBuilder.updateInstantiation",
    "onCommand:socBuilder.declareSignals",
    "onCommand:socBuilder.alignInstantiation"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "socBuilder.alignDeclarations",
        "title": "SoCBuilder: Align Declarations"
      },
      {
        "command": "socBuilder.instantiateModuleByName",
        "title": "SoCBuilder: Instantiate Module By Name"
      },
      {
        "command": "socBuilder.updateInstantiation",
        "title": "SoCBuilder: Update Instantiation"
      },
      {
        "command": "socBuilder.declareSignals",
        "title": "SoCBuilder: Declare Signals"
      },
      {
        "command": "socBuilder.alignInstantiation",
        "title": "SoCBuilder: Align Instantiation"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "socBuilder.alignDeclarations",
          "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/",
          "group": "navigation"
        },
        {
          "command": "socBuilder.instantiateModuleByName",
          "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/",
          "group": "navigation"
        },
        {
          "command": "socBuilder.updateInstantiation",
          "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/",
          "group": "navigation"
        },
        {
          "command": "socBuilder.alignInstantiation",
          "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "socBuilder.alignDeclarations",
        "key": "ctrl+alt+a",
        "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/"
      },
      {
        "command": "socBuilder.instantiateModuleByName",
        "key": "ctrl+alt+i",
        "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/"
      },
      {
        "command": "socBuilder.updateInstantiation",
        "key": "ctrl+alt+u",
        "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/"
      },
      {
        "command": "socBuilder.declareSignals",
        "key": "ctrl+alt+d",
        "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/"
      },
      {
        "command": "socBuilder.alignInstantiation",
        "key": "ctrl+alt+l",
        "when": "editorTextFocus && editorLangId =~ /verilog|systemverilog/"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.88.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
